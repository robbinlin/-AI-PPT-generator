{
  "$ref": "#/definitions/parser-manifest",
  "definitions": {
    "parser-manifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "pptx",
            "ppt",
            "pdf"
          ]
        },
        "pageCount": {
          "type": "integer",
          "minimum": 0
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pageNumber": {
                "type": "integer",
                "minimum": 1
              },
              "imagePath": {
                "type": "string"
              },
              "thumbnailPath": {
                "type": "string"
              },
              "contentPath": {
                "type": "string"
              },
              "imageWidthPx": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "imageHeightPx": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "pageNumber",
              "imagePath",
              "thumbnailPath",
              "contentPath",
              "imageWidthPx",
              "imageHeightPx"
            ],
            "additionalProperties": false
          }
        },
        "meta": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "author": {
              "type": "string"
            },
            "converter": {
              "type": "string"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "durationMs": {
              "type": "number"
            }
          },
          "additionalProperties": false,
          "default": {
            "warnings": []
          }
        }
      },
      "required": [
        "schemaVersion",
        "sourceKind",
        "pageCount",
        "pages"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
