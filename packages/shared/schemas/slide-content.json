{
  "$ref": "#/definitions/slide-content",
  "definitions": {
    "slide-content": {
      "type": "object",
      "properties": {
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "textBlocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "title",
                  "subtitle",
                  "body",
                  "bullet",
                  "caption",
                  "table",
                  "note",
                  "other"
                ],
                "default": "body"
              },
              "bbox": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              "level": {
                "type": "integer",
                "minimum": 0,
                "default": 0
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "notes": {
          "type": "string"
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rows": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "bbox": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "rows"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "bbox": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              },
              "altText": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "default": []
        },
        "charts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "chartType": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "dataSummary": {
                "type": "string"
              },
              "bbox": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number"
                  },
                  "h": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "default": []
        },
        "plainText": {
          "type": "string",
          "default": ""
        },
        "hasText": {
          "type": "boolean",
          "default": true
        },
        "needsOcr": {
          "type": "boolean",
          "default": false
        },
        "widthPt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "heightPt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "renderFidelity": {
          "type": "string",
          "enum": [
            "native",
            "converted",
            "fallback"
          ]
        }
      },
      "required": [
        "pageNumber",
        "widthPt",
        "heightPt",
        "renderFidelity"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
