# ---- API ----
PORT=4000
# "localhost" listens on both IPv4 and IPv6 loopback; set 0.0.0.0 when running in a container
HOST=localhost
# Postgres connection. Leave empty to use embedded PGlite under ./data/pglite (dev only).
DATABASE_URL=
# Local filesystem storage root (S3-compatible storage comes in v2).
STORAGE_ROOT=./data/storage
# Public base URL used in signed asset links.
PUBLIC_BASE_URL=http://localhost:4000

# ---- Providers (platform-managed keys; user-supplied keys are stored encrypted in DB) ----
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-3.8-flash / gemini-3.8-flash-tts)
GEMINI_LLM_MODEL=
GEMINI_TTS_MODEL=
# Comma-separated models tried when the primary LLM model is overloaded
GEMINI_LLM_FALLBACK_MODELS=gemini-3.5-flash
# Fast model for per-slide scripts (no deliberation needed); lite models answer in seconds on free keys
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
# Reasoning levels routed to the fast model (none = scripts, low = outline). Paid keys may set "none" to plan with the flagship model.
GEMINI_FAST_FOR=none,low
# Force thinking for every call: none | low | high (default: per task)
GEMINI_THINKING=
GEMINI_TTS_FALLBACK_MODELS=gemini-3.8-flash-lite-tts,gemini-3.1-flash-tts-preview
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
# ElevenLabs TTS model (default eleven_v3, best for Mandarin; eleven_multilingual_v2 / eleven_flash_v2_5 also work)
ELEVENLABS_MODEL=
HEYGEN_API_KEY=
# HeyGen engine: avatar_iv (default, best quality) or avatar_iii (cheaper talking-photo engine)
HEYGEN_ENGINE=
# Set to 0 to keep the look's own backdrop instead of matting the avatar onto chroma green
HEYGEN_REMOVE_BACKGROUND=
# 32-byte base64 key used to encrypt user-supplied provider keys at rest.
# Leave empty to have one generated once and kept in data/secrets.json.
PROVIDER_KEY_ENCRYPTION_KEY=

# Self-hosted avatar service (workers/avatar-local, free, runs on your GPU)
LOCAL_AVATAR_URL=http://127.0.0.1:8765

# Show the offline mock providers in the UI (tests/demos only)
EXPOSE_MOCK_PROVIDERS=0

# ---- Workers ----
PARSER_PYTHON=python3
PARSER_CLI=./workers/parser
SOFFICE_BIN=soffice
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
