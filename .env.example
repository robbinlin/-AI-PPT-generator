# ---- API ----
PORT=4000
# Postgres connection. Leave empty to use embedded PGlite under ./data/pglite (dev only).
DATABASE_URL=
# Local filesystem storage root (S3-compatible storage comes in v2).
STORAGE_ROOT=./data/storage
# Public base URL used in signed asset links.
PUBLIC_BASE_URL=http://localhost:4000

# ---- Providers (platform-managed keys; user-supplied keys are stored encrypted in DB) ----
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
HEYGEN_API_KEY=
# 32-byte base64 key used to encrypt user-supplied provider keys at rest
PROVIDER_KEY_ENCRYPTION_KEY=

# ---- Workers ----
PARSER_PYTHON=python3
PARSER_CLI=./workers/parser
SOFFICE_BIN=soffice
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
