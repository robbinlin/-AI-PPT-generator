{
  "name": "lecture-video-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" --filter \"./workers/render\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm build:libs && pnpm -r test",
    "dev": "node scripts/dev-all.mjs",
    "dev:api": "pnpm build:libs && pnpm --filter @lvs/api dev",
    "serve:api": "pnpm build:libs && pnpm --filter @lvs/api serve",
    "dev:web": "pnpm --filter @lvs/shared build && pnpm --filter @lvs/web dev",
    "dev:avatar": "node workers/avatar-local/start.mjs",
    "dev:tts": "node workers/tts-local/start.mjs",
    "build:libs": "pnpm -r --filter \"./packages/**\" --filter @lvs/render build"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
